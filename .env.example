# Copy to `.env.local` for a local production-like build. None of these are
# needed for `npm run dev`.
#
# On GitHub Pages the first two are filled in automatically by the deploy
# workflow, and NEXT_PUBLIC_GA_ID comes from a repository variable
# (Settings -> Secrets and variables -> Actions -> Variables).

# Canonical base of the deployed site, sub-path included. Drives canonical
# links, the sitemap, Open Graph tags and the web manifest.
NEXT_PUBLIC_SITE_URL=https://your-name.github.io/chinese

# Sub-path the site is served under; empty when it sits at a domain root.
# Must agree with the path in NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_BASE_PATH=/chinese

# Google Analytics 4 measurement ID. Leave unset to ship no analytics and no
# cookie banner at all — the site behaves identically without it.
NEXT_PUBLIC_GA_ID=
